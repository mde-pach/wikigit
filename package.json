{
  "name": "fork-and-go-wiki",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "build:e2e": "SITE_URL=https://wikigit.org BASE_PATH=/ PUBLIC_WORKER_URL=https://api.wikigit.org PUBLIC_REPO_OWNER=mde-pach PUBLIC_REPO_NAME=wikigit PUBLIC_PLATFORM_HOST=wikigit.org astro build",
    "test:e2e": "bun run build:e2e && playwright test",
    "verify": "biome check . && vitest run && astro build && cd worker && bun run verify && cd ../accounts && bun test"
  },
  "dependencies": {
    "@astrojs/solid-js": "^5.0.4",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fontsource-variable/libre-franklin": "^5.2.8",
    "@fontsource-variable/source-serif-4": "^5.2.9",
    "astro": "^5.6.1",
    "dompurify": "^3.2.4",
    "iso-639-1": "^3.1.5",
    "markdown-it": "^14.1.0",
    "markdown-it-anchor": "^9.2.0",
    "markdown-it-footnote": "^4.0.0",
    "mermaid": "^11.15.0",
    "solid-js": "^1.9.5",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.1.2",
    "@playwright/test": "^1.65.1",
    "@types/markdown-it": "^14.1.2",
    "@types/markdown-it-anchor": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.9",
    "vitest": "^4.1.8"
  }
}
